# ─────────────────────────────────────────────────────────────
# AI Warranty Vault — client environment
# Copy this file to `.env` and fill in your Supabase project values.
# Everything here is EXPO_PUBLIC_* and ships in the app bundle — the anon
# key is safe to expose because Row Level Security enforces access.
# NEVER put the Supabase service-role key or ANTHROPIC_API_KEY here.
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────────────────────
# Server-side secrets below are NOT read by the app. They belong in the
# Supabase Edge Function environment (set with `supabase secrets set ...`).
# Listed here only for documentation. See supabase/.env.example.
# ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_SERVICE_ROLE_KEY=...
